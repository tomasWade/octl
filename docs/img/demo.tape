Output docs/img/demo.gif
Set FontFamily "Noto Sans Mono CJK SC"
Set FontSize 15
Set Width 1100
Set Height 620
Set Theme "TokyoNight"

Hide
Type "HOME=/tmp/opencode/fakehome ~/bin/octl"
Enter
Sleep 2500ms
Show
Type "l"
Sleep 600ms
Type "j"
Sleep 250ms
Type "j"
Sleep 250ms
Space
Sleep 400ms
Type "j"
Sleep 200ms
Space
Sleep 400ms
Type "f"
Sleep 900ms
Type "2"
Sleep 1400ms
Type "3"
Sleep 1300ms
Type "1"
Sleep 800ms
Hide
Ctrl+x
Sleep 400ms
